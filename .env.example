# Copie este arquivo para .env e preencha os valores.
# O .env nunca vai para o Git; este .env.example vai, sem segredos.

# --- Postgres (serviço db) ---
POSTGRES_USER=radar
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=radar

# --- n8n ---
# Gere com: openssl rand -hex 32
# Se perder esta chave, as credenciais salvas no n8n ficam ilegíveis.
N8N_ENCRYPTION_KEY=

# --- Gemini (Fase 3) ---
# Crie em https://aistudio.google.com/apikey e cole depois do "=", sem aspas e sem espaço.
GEMINI_API_KEY=
# Modelo do agente. Barato para estudar: gemini-3.5-flash-lite. Mais forte: gemini-3.8-flash.
# Confira os nomes disponíveis na opção "Listar modelos" do fase3.bat.
MODELO_LLM=gemini-3.5-flash-lite

# --- Limites do harness (Fase 3) ---
# Chamadas ao modelo por avaliação. Experimento 1: troque para 2 e veja o que acontece.
LIMITE_PASSOS=8
LIMITE_SEGUNDOS=120
# Tokens de entrada + saída somados, por avaliação.
LIMITE_TOKENS=60000

# --- Fase 4: chave entre n8n e agente ---
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
# O n8n manda esta chave no cabeçalho X-API-Key; o agente recusa quem não mandar.
AGENTE_API_KEY=

# --- Fase 5: custo estimado no relatório (US$ por 1 milhão de tokens) ---
# Plano gratuito: deixe 0. Preços em https://ai.google.dev/gemini-api/docs/pricing
PRECO_ENTRADA_1M=0
PRECO_SAIDA_1M=0
